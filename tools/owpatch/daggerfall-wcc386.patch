+/*
+ * Daggerfall: at -od, Watcom 10 gave stack slots to the declared variables from the top of
+ * the frame down in this order: 2-byte parameters and then 2-byte locals (last to first), the
+ * return variable, the locals last to first, the parameters last to first. Open Watcom gives slots at first use. DaggerAllocAtDecl()
+ * records each declaration (kind DAGGER_PARM, DAGGER_AUTO or DAGGER_TEMP);
+ * DaggerAllocDeclared() gives the slots when the first statement is generated.
+ * DAGGER_FIRSTUSE=1 restores Open Watcom's order.
+ */
+#define DAGGER_MAX_DECLS    512
+
+bool                DaggerAutoNested;       /* set by the C front end */
+
+static proc_def     *DaggerProc;
+static name         *DaggerDecls[DAGGER_MAX_DECLS];
+static int          DaggerKinds[DAGGER_MAX_DECLS];
+static int          DaggerCount;
+
+void    DaggerAllocAtDecl( name *temp, int kind )
+/***********************************************/
+{
+    if( _IsntModel( CGSW_GEN_NO_OPTIMIZATION ) || getenv( "DAGGER_FIRSTUSE" ) != NULL )
+        return;
+    if( DaggerProc != CurrProc ) {
+        DaggerProc = CurrProc;
+        DaggerCount = 0;
+    }
+    if( DaggerCount < DAGGER_MAX_DECLS ) {
+        DaggerKinds[DaggerCount] = kind;
+        DaggerDecls[DaggerCount++] = temp;
+    }
+}
+
+static void DaggerAlloc( name *temp )
+/***********************************/
+{
+    temp = DeAlias( temp );
+    temp->v.usage |= NEEDS_MEMORY | USE_MEMORY | USE_IN_ANOTHER_BLOCK;
+    AllocALocal( temp );
+}
+
+void    DaggerAllocDeclared( void )
+/*********************************/
+{
+    int     i;
+
+    if( DaggerProc != CurrProc || DaggerCount == 0 )
+        return;
+    /* 2-byte variables come first: parameters, then locals, last to first */
+    for( i = DaggerCount; i-- > 0; ) {
+        if( DaggerKinds[i] == DAGGER_PARM && DaggerDecls[i]->n.size == 2 ) {
+            DaggerAlloc( DaggerDecls[i] );
+        }
+    }
+    for( i = DaggerCount; i-- > 0; ) {
+        if( DaggerKinds[i] == DAGGER_AUTO && DaggerDecls[i]->n.size == 2 ) {
+            DaggerAlloc( DaggerDecls[i] );
+        }
+    }
+    for( i = 0; i < DaggerCount; i++ ) {
+        if( DaggerKinds[i] == DAGGER_TEMP ) {
+            DaggerAlloc( DaggerDecls[i] );
+        }
+    }
+    for( i = DaggerCount; i-- > 0; ) {
+        if( DaggerKinds[i] == DAGGER_AUTO ) {
+            DaggerAlloc( DaggerDecls[i] );
+        }
+    }
+    for( i = DaggerCount; i-- > 0; ) {
+        if( DaggerKinds[i] == DAGGER_PARM ) {
+            DaggerAlloc( DaggerDecls[i] );
+        }
+    }
+    /* then nested-block locals, last to first */
+    for( i = DaggerCount; i-- > 0; ) {
+        if( DaggerKinds[i] == DAGGER_NESTED ) {
+            DaggerAlloc( DaggerDecls[i] );
+        }
+    }
+    DaggerCount = 0;
+}
+
