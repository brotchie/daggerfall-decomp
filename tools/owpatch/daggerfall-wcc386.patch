+ * func_XXXXXXXX; padding before a switch table (an aligned label) then comes out as in
+ * FALL.EXE. DAGGER_NOALIGNBIAS=1 aligns to the object's own offsets (stock).
+ */
+static offset   DaggerAlignBias;
