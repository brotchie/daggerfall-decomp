+{
+    if( DaggerAlignCount < DAGGER_MAX_ALIGN ) {
+        DaggerAlignLbl[DaggerAlignCount] = lbl;
+        DaggerAlignVal[DaggerAlignCount] = align;
+        DaggerAlignCount++;
+    }
