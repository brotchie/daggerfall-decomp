+
+static void pragDagger( void )
+/*****************************
+ * Daggerfall: `#pragma dagger <option> <function>` switches a code generator heuristic
+ * for one function (see DaggerFuncOpt() in cg/c/generate.c)
+ */
+{
+    char    opt[32];
+
+    PPNextToken();
+    if( !IS_ID_OR_KEYWORD( CurToken ) )
+        return;
+    strncpy( opt, Buffer, sizeof( opt ) - 1 );
+    opt[sizeof( opt ) - 1] = '\0';
+    PPNextToken();
+    if( !IS_ID_OR_KEYWORD( CurToken ) )
+        return;
+    if( strcmp( opt, "slots" ) == 0 ) {
+        /* #pragma dagger slots <function> <variable> <depth> ...: each variable's frame
+         * depth below the saved registers, as in FALL.EXE */
+        char    func[40];
+        char    var[40];
+
+        strncpy( func, Buffer, sizeof( func ) - 1 );
+        func[sizeof( func ) - 1] = '\0';
+        PPNextToken();
+        while( IS_ID_OR_KEYWORD( CurToken ) ) {
+            strncpy( var, Buffer, sizeof( var ) - 1 );
+            var[sizeof( var ) - 1] = '\0';
+            PPNextToken();
+            if( CurToken != T_CONSTANT )
+                break;
+            DaggerSlotAdd( func, var, (int)U64Low( Constant64 ) );
+            PPNextToken();
+        }
+        return;
+    }
+    if( strcmp( opt, "reg" ) == 0 ) {
+        /* #pragma dagger reg <function> <k> <register> ...: the k-th register choice of
+         * the function's allocator takes that register (a last resort) */
+        char    func[40];
+        int     k;
+
+        strncpy( func, Buffer, sizeof( func ) - 1 );
+        func[sizeof( func ) - 1] = '\0';
+        PPNextToken();
+        while( CurToken == T_CONSTANT ) {
+            k = (int)U64Low( Constant64 );
+            PPNextToken();
+            if( !IS_ID_OR_KEYWORD( CurToken ) )
+                break;
+            DaggerRegPinAdd( func, k, Buffer );
+            PPNextToken();
+        }
+        return;
+    }
+    DaggerFuncOptAdd( opt, Buffer );
+    PPNextToken();
+}
