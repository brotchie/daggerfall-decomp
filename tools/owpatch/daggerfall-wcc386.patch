+        return;
+    name = FEName( sym );
+    if( name == NULL || strncmp( name, "func_", 5 ) != 0 )
+        return;
+    va = strtoul( name + 5, &end, 16 );
+    if( end != name + 13 )
+        return;
+    DaggerAlignBias = (offset)va - lc;
