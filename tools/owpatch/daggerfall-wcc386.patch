+/* Daggerfall: the front end marks where a switch table goes (see optmain.c). Before the
+ * prologue exists, that spot is right after the prologue (DaggerPrologDone()). */
+static bool DaggerMarkPending;
+
+int     DaggerTableAlign;   /* 0x10 | original table address & 0xF, or 0 */
+
+void    DaggerTableHere( int align )
+/**********************************/
+{
+    DaggerTableAlign = align;
+    if( CurrProc == NULL || (CurrProc->prolog_state & PST_PROLOG_GENERATED) == 0 ) {
+        DaggerMarkPending = true;
+    } else {
+        DaggerMarkNow();
+    }
+}
+
+void    (*DaggerDeferredEmit)( void );
+
+int     DaggerTableState( void )
+/******************************/
+/* 0: no mark, 1: marked in the queue, 2: marked before the prologue */
+{
+    if( DaggerMarkPending )
+        return( 2 );
+    return( DaggerMarkIsSet() ? 1 : 0 );
+}
+
+void    DaggerTableConsumed( void )
+/*********************************/
+{
+    DaggerMarkPending = false;
+}
+
+void    DaggerPrologDone( void )
+/******************************/
+{
+    if( DaggerMarkPending ) {
+        DaggerMarkPending = false;
+        DaggerMarkNow();
+    }
+    if( DaggerDeferredEmit != NULL ) {
+        void (*emit)( void ) = DaggerDeferredEmit;
+
+        DaggerDeferredEmit = NULL;
+        emit();
+    }
+}
