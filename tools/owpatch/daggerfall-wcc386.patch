+/*
+ * Daggerfall: at -od, Watcom 10 gave stack slots to the declared variables from the top of
+ * the frame down in this order: 2-byte parameters and then 2-byte locals (last to first), the
+ * return variable, the locals last to first, the parameters last to first. Open Watcom gives slots at first use. DaggerAllocAtDecl()
+ * records each declaration (kind DAGGER_PARM, DAGGER_AUTO or DAGGER_TEMP);
+ * DaggerAllocDeclared() gives the slots when the first statement is generated.
+ * DAGGER_FIRSTUSE=1 restores Open Watcom's order.
+ */
+#define DAGGER_MAX_DECLS    512
+
+bool                DaggerAutoNested;       /* set by the C front end */
+bool                DaggerNoSlot;           /* set by the C front end: a hidden symbol */
+static name         *DaggerNoSlots[DAGGER_MAX_DECLS];
+static int          DaggerNoSlotCount;
+static proc_def     *DaggerNoSlotProc;
+
+bool    DaggerIsNoSlot( name *op )
+/********************************/
+{
+    int     i;
+
+    if( DaggerNoSlotProc != CurrProc )
+        return( false );
+    for( i = 0; i < DaggerNoSlotCount; i++ ) {
+        if( DaggerNoSlots[i] == op ) {
+            return( true );
+        }
+    }
+    return( false );
+}
+
+
+
+static proc_def     *DaggerProc;
+static name         *DaggerDecls[DAGGER_MAX_DECLS];
+static int          DaggerKinds[DAGGER_MAX_DECLS];
+static int          DaggerCount;
+
+void    DaggerAllocAtDecl( name *temp, int kind )
+/***********************************************/
+{
+    if( _IsntModel( CGSW_GEN_NO_OPTIMIZATION ) || DaggerEnv( "DAGGER_FIRSTUSE" ) != NULL )
+        return;
+    if( DaggerProc != CurrProc ) {
+        DaggerProc = CurrProc;
+        DaggerCount = 0;
+    }
+    if( DaggerCount < DAGGER_MAX_DECLS ) {
+        DaggerKinds[DaggerCount] = kind;
+        DaggerDecls[DaggerCount++] = temp;
+    }
+}
+
+/*
+ * Daggerfall: `#pragma dagger slots` pins declared variables at their frame depth in FALL.EXE
+ * (a last resort the lifter's search uses when the layout rules don't reproduce a frame)
+ */
+#define DAGGER_MAX_SLOTS    1024
+static char     DaggerSlotFunc[DAGGER_MAX_SLOTS][40];
+static char     DaggerSlotVar[DAGGER_MAX_SLOTS][40];
+static int      DaggerSlotDepth[DAGGER_MAX_SLOTS];
+static int      DaggerSlotCount;
+
+void    DaggerSlotAdd( const char *func, const char *var, int depth )
+{
+    if( DaggerSlotCount < DAGGER_MAX_SLOTS ) {
+        strncpy( DaggerSlotFunc[DaggerSlotCount], func, 39 );
+        strncpy( DaggerSlotVar[DaggerSlotCount], var, 39 );
+        DaggerSlotDepth[DaggerSlotCount] = depth;
+        DaggerSlotCount++;
+    }
+}
+
+extern const char *DaggerCurrProcName( void );   /* generate.c */
+#define DaggerProcName  DaggerCurrProcName
+
+static name     *DaggerRetTemp;     /* the function's first CGTemp: its return variable */
+
+static int DaggerSlotDepthOf( name *temp )
+/* the pinned depth of a declared variable, or 0 */
+{
+    const char  *func;
+    const char  *var;
+    int         i;
+
+    if( DaggerSlotCount == 0 || temp->n.class != N_TEMP )
+        return( 0 );
+    func = DaggerProcName();
+    /* the return variable has no name: `ret` */
+    var = temp->v.symbol == NULL ? ( temp == DaggerRetTemp ? "ret" : NULL ) : FEName( temp->v.symbol );
+    if( func == NULL || var == NULL )
+        return( 0 );
+    for( i = 0; i < DaggerSlotCount; i++ ) {
+        if( strcmp( DaggerSlotFunc[i], func ) == 0 && strcmp( DaggerSlotVar[i], var ) == 0 )
+            return( DaggerSlotDepth[i] );
+    }
+    return( 0 );
+}
+
+static void DaggerSlotsReserve( void )
+/* the pinned region is below the saved registers; everything else goes under it */
+{
+    const char  *func;
+    int         i;
+    int         deepest;
+
+    func = DaggerProcName();
+    if( func == NULL )
+        return;
+    deepest = 0;
+    for( i = 0; i < DaggerSlotCount; i++ ) {
+        if( strcmp( DaggerSlotFunc[i], func ) == 0 && DaggerSlotDepth[i] > deepest )
+            deepest = DaggerSlotDepth[i];
+    }
+    if( deepest > (int)CurrProc->locals.size )
+        CurrProc->locals.size = deepest;
+}
+
+static void DaggerAlloc( name *temp )
+/***********************************/
+{
+    int     depth;
+
+    temp = DeAlias( temp );
+    depth = DaggerSlotDepthOf( temp );
+    if( depth != 0 ) {
+        if( (temp->v.usage & HAS_MEMORY) == 0 ) {
+            temp->v.usage |= NEEDS_MEMORY | USE_MEMORY | USE_IN_ANOTHER_BLOCK | HAS_MEMORY;
+            temp->t.location = - depth - CurrProc->locals.base;
+            PropLocal( temp );
+        }
+        return;
+    }
+    temp->v.usage |= NEEDS_MEMORY | USE_MEMORY | USE_IN_ANOTHER_BLOCK;
+    AllocALocal( temp );
+}
+
+void    DaggerAllocDeclared( void )
+/*********************************/
+{
+    int     i;
+
+    if( DaggerProc != CurrProc || DaggerCount == 0 )
+        return;
+    if( DaggerSlotCount != 0 )
+        DaggerSlotsReserve();
+    /* 2-byte variables come first: parameters, then locals, last to first */
+    for( i = DaggerCount; i-- > 0; ) {
+        if( DaggerKinds[i] == DAGGER_PARM && ( DaggerDecls[i]->n.size == 2
+          || ( DaggerDecls[i]->n.size == 1 && DaggerEnv( "DAGGER_CHARPARMBIG" ) == NULL ) ) ) {
+            DaggerAlloc( DaggerDecls[i] );
+        }
+    }
+    for( i = DaggerCount; i-- > 0; ) {
+        if( DaggerKinds[i] == DAGGER_AUTO && ( DaggerDecls[i]->n.size == 2
+          || ( DaggerDecls[i]->n.size == 1 && DaggerEnv( "DAGGER_CHARAUTOSMALL" ) != NULL ) ) ) {
+            DaggerAlloc( DaggerDecls[i] );
+        }
+    }
+    DaggerRetTemp = NULL;
+    for( i = 0; i < DaggerCount; i++ ) {
+        if( DaggerKinds[i] == DAGGER_TEMP ) {
+            if( DaggerRetTemp == NULL )
+                DaggerRetTemp = DeAlias( DaggerDecls[i] );
+            DaggerAlloc( DaggerDecls[i] );
+        }
+    }
+    for( i = DaggerCount; i-- > 0; ) {
+        if( DaggerKinds[i] == DAGGER_AUTO ) {
+            DaggerAlloc( DaggerDecls[i] );
+        }
+    }
+    for( i = DaggerCount; i-- > 0; ) {
+        if( DaggerKinds[i] == DAGGER_PARM ) {
+            DaggerAlloc( DaggerDecls[i] );
+        }
+    }
+    /* then nested-block locals, last to first (DAGGER_NESTEDLAZY: at first use instead) */
+    for( i = DaggerCount; i-- > 0; ) {
+        if( DaggerKinds[i] == DAGGER_NESTED && DaggerEnv( "DAGGER_NESTEDLAZY" ) == NULL ) {
+            DaggerAlloc( DaggerDecls[i] );
+        }
+    }
+    DaggerCount = 0;
+}
