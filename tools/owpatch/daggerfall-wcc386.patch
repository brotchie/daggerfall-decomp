+static  name    *KKNDTemps[64];
+static  int     KKNDNumTemps;
+
+bool    KKNDIsGlobalConstTemp( name *op )
+{
+    int     i;
+
+    for( i = 0; i < KKNDNumTemps; ++i ) {
+        if( KKNDTemps[i] == op ) {
+            return( true );
+        }
+    }
+    return( false );
+}
+
+
+void    KKNDConstToTempFunc( void )
+/**********************************
+    KKND experiment: Watcom 10.x stored constants to global (N_MEMORY) variables through a
+    register: mov ebx,1; xor edx,edx; mov [A],ebx; mov [B],edx. Struct-field stores keep the
+    immediate. Cache every constant that is moved into a global in a temp, for those moves only.
+*/
+{
+    name                *cons;
+    name                *temp;
+    block               *blk;
+    instruction         *ins;
+
+    KKNDNumTemps = 0;
+    for( cons = Names[N_CONSTANT]; cons != NULL; cons = cons->n.next_name ) {
+        if( cons->c.const_type != CONS_ABSOLUTE )
+            continue;
+        temp = NULL;
+        for( blk = HeadBlock; blk != NULL; blk = blk->next_block ) {
+            for( ins = blk->ins.head.next; ins->head.opcode != OP_BLOCK; ins = ins->head.next ) {
+                if( ins->head.opcode != OP_MOV || ins->operands[0] != cons )
+                    continue;
+                if( getenv( "KKND_DEBUG" ) != NULL )
+                    fprintf( stderr, "KKND mov const %ld class %d resclass %d\n", (long)cons->c.lo.u.int_value, ins->type_class, ins->result->n.class );
+                if( ins->result->n.class != N_MEMORY )
+                    continue;
+                if( ins->type_class != WD && ins->type_class != SW
+                  && ins->type_class != U4 && ins->type_class != I4 )
+                    continue;
+                if( temp == NULL ) {
+                    temp = AllocTemp( ins->type_class );
+                    temp->t.temp_flags |= CONST_TEMP;
+                    temp->v.symbol = cons;
+                    temp->v.usage |= USE_IN_ANOTHER_BLOCK;
+                    if( KKNDNumTemps < 64 )
+                        KKNDTemps[KKNDNumTemps++] = temp;
+                    PrefixIns( HeadBlock->ins.head.next, MakeMove( cons, temp, ins->type_class ) );
+                }
+                if( ins->type_class == temp->n.type_class ) {
+                    ins->operands[0] = temp;
+                }
+            }
+        }
+    }
+}
