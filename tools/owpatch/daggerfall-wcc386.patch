+static bool DaggerStripConvert( cg_op opcode, tn base, tn rite )
+/****************************************************************
+ * Daggerfall: compare a widened byte/word against a constant at its own size? Open Watcom
+ * always does (`cmp byte ptr [x], K`); Watcom 10 at -od often compared the widened value
+ * (`xor eax,eax; mov al,[x]; cmp eax,K`) when the source converted explicitly (`(int)x`);
+ * a plain `x == K` is still narrowed by ResultType(). Rule from DAGGER_STRIP:
+ *   never (default at -od)  never strip an explicit conversion
+ *   ow            always strip (stock Open Watcom)
+ *   local         strip for locals only
+ *   eq            strip for == / != only
+ *   localeq0      strip for locals, or == / != against 0
+ */
+{
+    const char  *policy;
+    bool        local;
+    bool        eq;
+    bool        zero;
+
+    policy = getenv( "DAGGER_STRIP" );
+    if( _IsntModel( CGSW_GEN_NO_OPTIMIZATION ) )
+        return( true );
+    if( policy == NULL )
+        policy = "never";
+    if( strcmp( policy, "ow" ) == 0 )
+        return( true );
+    local = ( base->class == TN_LEAF && base->u.name->n.class == N_TEMP );
+    eq = ( opcode == O_EQ || opcode == O_NE );
+    zero = ( CFTest( rite->u.name->c.u.cfval ) == 0 );
+    if( strcmp( policy, "never" ) == 0 )
+        return( false );
+    if( strcmp( policy, "local" ) == 0 )
+        return( local );
+    if( strcmp( policy, "eq" ) == 0 )
+        return( eq );
+    if( strcmp( policy, "localeq0" ) == 0 )
+        return( local || ( eq && zero ) );
+    return( true );
+}
