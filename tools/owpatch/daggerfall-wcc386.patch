+{
+    int     i;
+
+    for( i = 0; i < DaggerAlignCount; i++ ) {
+        if( DaggerAlignLbl[i] == lbl ) {
+            DaggerAlignLbl[i] = DaggerAlignLbl[--DaggerAlignCount];
+            return( DaggerAlignVal[i] );
+        }
+    }
+    return( 0 );
