+/* A switch table sat at an address aligned relative to its unit's start, not to the image:
+ * the front end passes the table's original address (low bits) and the table is padded to
+ * land on the same address mod 16 (DAGGER_NOTBLALIGN=1: plain alignment). */
+#define DAGGER_MAX_ALIGN    64
