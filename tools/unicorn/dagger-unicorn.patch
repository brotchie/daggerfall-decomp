+
+// dagger: code coverage. out == NULL starts recording [lo, hi) afresh (a byte per guest code
+// byte, set once a translation block covering it is made, i.e. once it is about to run);
+// otherwise copies the map (hi - lo bytes) into out.
+UNICORN_EXPORT
+uc_err uc_dagger_coverage(uc_engine *uc, uint64_t lo, uint64_t hi, uint8_t *out)
+{
+    if (hi <= lo) {
+        return UC_ERR_ARG;
+    }
+    if (!out) {
+        g_free(uc->cov_map);
+        uc->cov_map = g_malloc0(hi - lo);
+        uc->cov_lo = lo;
+        uc->cov_hi = hi;
+        // code translated before recording started would never be seen: start over
+        if (uc->init_done) {
+            uc->tb_flush(uc);
+        }
+        return UC_ERR_OK;
+    }
+    if (!uc->cov_map || lo != uc->cov_lo || hi != uc->cov_hi) {
+        return UC_ERR_ARG;
+    }
+    memcpy(out, uc->cov_map, hi - lo);
+    return UC_ERR_OK;
+}
